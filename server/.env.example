# ── Database ────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string. Create the database first:
#   createdb peoplepay360
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peoplepay360

# ── Auth ────────────────────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# Origin allowed by CORS — must match where the Vite dev server is served from.
CLIENT_ORIGIN=http://localhost:5173
